@model IEnumerable<StudentCourses>
<!--this is the  table that display students in a course-->
<table class="table">
    <thead>
        <tr>
            <th>
                ID
            </th>
            <th>
                name
            </th>
            <th>
                <a asp-action="addStudentToCourse" asp-route-course="t">add student</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <!-- display every student in course and thier grades-->
        @foreach (var item in Model)
            {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.StudentId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Grade)
                </td>
                <td>
                    <a asp-action="dropStudent" asp-route-courseId="@item.CourseId" asp-route-studentId="@item.StudentId">remove student</a>
                </td>
            </tr>
            }
    </tbody>
</table>